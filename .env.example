# FileFlow 环境变量配置
# 复制此文件为 .env 并修改相应的值

# 初始团队所有者（首次启动必需；创建后使用数据库中的成员密码）
FILEFLOW_ADMIN_USER=admin
FILEFLOW_ADMIN_PASSWORD=your-secure-password-here

# JWT 密钥（必需，建议使用 openssl rand -base64 32 生成）
FILEFLOW_JWT_SECRET=your-jwt-secret-key-here

# 服务配置
FILEFLOW_PORT=8080
FILEFLOW_DATA_DIR=./data

# MCP 浏览器跨域来源（可选，逗号分隔的完整 Origin；原生 Agent 无需设置）
# FILEFLOW_MCP_ALLOWED_ORIGINS=https://agent.example.com

# 反向代理连接本机回环地址时，允许保留的公网 Host（精确 host[:port]，禁止 *）
# FILEFLOW_MCP_ALLOWED_HOSTS=files.example.com

# 数据库配置（可选，默认 SQLite）
# 支持格式：
#   sqlite:./data/fileflow.db
#   libsql://xxx.turso.io?authToken=xxx
#   mysql://user:pass@host:port/db
#   postgres://user:pass@host:port/db
#   redis://host:port/db
#   mongodb://host:port/db
FILEFLOW_DATABASE_URL=
